{
  "name": "quake3-wasm",
  "version": "0.1.0",
  "private": true,
  "description": "Quake III Arena in the browser with a supervised shared match",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/theodorecharles/quake3-wasm.git"
  },
  "license": "GPL-2.0-or-later",
  "scripts": {
    "setup:data": "bash scripts/setup-game-data.sh",
    "build": "npm run build:client && npm run build:server",
    "build:client": "bash scripts/build-web-client.sh",
    "build:server": "bash scripts/build-dedicated.sh",
    "start": "node server/index.js",
    "test": "node --test tests/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ws": "^8.18.3"
  }
}
