diff --git a/code/web/q3js_browser.c b/code/web/q3js_browser.c
new file mode 100644
index 00000000..50f959b9
--- /dev/null
+++ b/code/web/q3js_browser.c
@@ -0,0 +1,42 @@
+#include "../client/client.h"
+
+#ifdef __EMSCRIPTEN__
+#include <emscripten/emscripten.h>
+#else
+#define EMSCRIPTEN_KEEPALIVE
+#endif
+
+EMSCRIPTEN_KEEPALIVE int Q3JS_IsConnected( void )
+{
+    return clc.state == CA_ACTIVE ? 1 : 0;
+}
+
+EMSCRIPTEN_KEEPALIVE void Q3JS_SetQuality( int profile )
+{
+    static const char *picmip[] = { "3", "2", "1", "0" };
+    static const char *subdivisions[] = { "20", "12", "8", "4" };
+    static const char *lodBias[] = { "2", "1", "0", "-2" };
+    static const char *shadows[] = { "0", "0", "1", "2" };
+
+    if( profile < 0 ) profile = 0;
+    if( profile > 3 ) profile = 3;
+    Cvar_Set( "r_picmip", picmip[profile] );
+    Cvar_Set( "r_subdivisions", subdivisions[profile] );
+    Cvar_Set( "r_lodbias", lodBias[profile] );
+    Cvar_Set( "cg_shadows", shadows[profile] );
+    Cvar_Set( "r_detailtextures", profile >= 2 ? "1" : "0" );
+    Cvar_Set( "r_dynamiclight", profile >= 2 ? "1" : "0" );
+    Cvar_Set( "r_fastsky", profile == 0 ? "1" : "0" );
+}
+
+EMSCRIPTEN_KEEPALIVE void Q3JS_Resize( int width, int height )
+{
+    if( width < 1 || height < 1 ) return;
+    if( Cvar_VariableIntegerValue( "r_customwidth" ) == width &&
+        Cvar_VariableIntegerValue( "r_customheight" ) == height &&
+        cls.glconfig.vidWidth == width && cls.glconfig.vidHeight == height ) return;
+    Cvar_SetValue( "r_customwidth", width );
+    Cvar_SetValue( "r_customheight", height );
+    Cvar_Set( "r_mode", "-1" );
+    Cbuf_ExecuteText( EXEC_APPEND, "vid_restart\n" );
+}
